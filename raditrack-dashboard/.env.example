# ==============================================================================
# RADiTrack Environment Variables (Template)
# ==============================================================================

# Supabase Transaction Pooler (Port 6543) - used by Next.js app at runtime
#DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) - used for Prisma migrations & schema push
#DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# Optional: Local SQLite Database Connection URL (Prisma 7)
# DATABASE_URL="file:./radiology.db"

# Sign-in sessions: a random string of at least 32 characters (keep it secret).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#SESSION_SECRET="..."

# Set to "false" only if staff open RADiTrack over plain http:// (e.g. phones on the LAN).
#SESSION_COOKIE_SECURE="false"
