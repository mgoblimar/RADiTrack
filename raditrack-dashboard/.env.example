# ==============================================================================
# RADiTrack Environment Variables (Template)
# Copy this file to '.env' before running migrations or starting Next.js:
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# ==============================================================================

# Local SQLite Database Connection URL (Prisma 7)
DATABASE_URL="file:./radiology.db"

# ------------------------------------------------------------------------------
# (Optional) Supabase / PostgreSQL Production Configuration:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"
# ------------------------------------------------------------------------------
