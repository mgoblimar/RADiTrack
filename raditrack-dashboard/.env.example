# ==============================================================================
# RADiTrack Environment Variables (Template)
# ==============================================================================

# Supabase Transaction Pooler (Port 6543) - used by Next.js app at runtime
#DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) - used for Prisma migrations & schema push
#DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# Optional: Local SQLite Database Connection URL (Prisma 7)
# DATABASE_URL="file:./radiology.db"

# ==============================================================================
# RIS sync agent (npm run ris:sync) - hospital Microsoft SQL Server, read-only
# See docs/ris-integration.md. Use the read-only login IT creates for RADiTrack.
# ==============================================================================
RIS_SQL_SERVER=""
RIS_SQL_PORT="1433"
RIS_SQL_DATABASE=""
RIS_SQL_USER=""
RIS_SQL_PASSWORD=""
RIS_VIEW="raditrack.vw_exams"
RIS_SQL_ENCRYPT="true"
# Only "true" if IT confirms the server uses a self-signed certificate
RIS_SQL_TRUST_SERVER_CERT="false"
RIS_SYNC_INTERVAL_MINUTES="5"
# First sync reads this many days back (about 14 months for the 12-month trend)
RIS_SYNC_LOOKBACK_DAYS="430"
