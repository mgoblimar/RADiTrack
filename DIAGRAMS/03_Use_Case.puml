@startuml raditrack_use_case
!theme plain
left to right direction
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam nodesep 12
skinparam ranksep 60
skinparam ArrowColor #334155
skinparam usecase {
    BackgroundColor #F8FAFC
    BorderColor #334155
}

title RADiTrack — Use Case Diagram (v0.2.2)

' ==============================================================================
' ACTORS (left), declared top to bottom in the same order as their use-case groups
' ==============================================================================

actor "Radiologist / Resident\n(signed-in doctor)" as Doctor
actor "RADiTrack\nAdministrator" as Admin
actor "Patient / Public\n(waiting area)" as Public
actor "Hospital IT" as HospitalIT
actor "RIS Sync Agent\n<<system, planned>>" as SyncAgent

rectangle "RADiTrack" {

    ' ---------------- Doctors (and administrators) ----------------
    package "Access" {
        usecase "Sign In" as UC_SignIn
        usecase "Open Dashboard on\nAssigned Modality" as UC_Default
        usecase "Change Password" as UC_Password
    }

    package "Reading & Sign-off" {
        usecase "View Reading Backlog\n(filter by waiting time)" as UC_Backlog
        usecase "Search & Filter Examinations" as UC_Search
        usecase "Sign Off Report" as UC_Sign
        usecase "Calculate TAT &\nSLA Breach" as UC_Tat
    }

    package "Monitoring & Reports" {
        usecase "View Dashboard KPIs" as UC_Kpi
        usecase "View TAT by Modality" as UC_ByModality
        usecase "View 7-Day TAT Table" as UC_SevenDay
        usecase "Compare Previous 7 Days" as UC_ComparePrev
        usecase "View 12-Month Trend" as UC_Trend
        usecase "Filter by Time Window,\nModality & Category" as UC_Filter
        usecase "Generate PDF Report" as UC_Report
        usecase "Export Examinations (CSV)" as UC_Export
        usecase "Read RADiTrack Guide" as UC_Guide
    }

    ' ---------------- Administrator only ----------------
    package "Administration: Examinations & Data" {
        usecase "Log Completed Examination\n(prototype: RIS Simulator)" as UC_Log
        usecase "Edit / Cancel / Delete Examination\n(not signed off)" as UC_Edit
        usecase "Import Exams (.xlsx / .csv)" as UC_Import
        usecase "Amend Signed-off Exam\n(within amendment window)" as UC_Amend
        usecase "Add Unknown Radiologist" as UC_AddRad
        usecase "Download Rejected Rows" as UC_Rejected
        usecase "View Audit Log &\nUpload History" as UC_AuditLog
        usecase "Undo an Upload" as UC_Undo
        usecase "Load Test Dataset /\nRestore Real Data" as UC_TestData
    }

    package "Administration: Configuration" {
        usecase "Manage Accounts &\nAssigned Modalities" as UC_Accounts
        usecase "Manage SLA Targets" as UC_Sla
        usecase "Set Amendment Window" as UC_Window
        usecase "Manage Modality Rooms" as UC_Rooms
    }

    ' ---------------- Public and RIS ----------------
    package "Public Display" {
        usecase "View Live Queue Status\n(Patient TV, no PII)" as UC_Tv
    }

    package "RIS Integration (planned)" {
        usecase "Provide Read-Only\nRIS View & Login" as UC_View
        usecase "Sync Exams from RIS\n(every 5 minutes)" as UC_Sync
    }
}

actor "Radiology Information\nSystem (RIS)\n<<system>>" as RIS

' ==============================================================================
' ACTOR ↔ USE CASE
' ==============================================================================

Doctor --> UC_SignIn
Doctor --> UC_Password
Doctor --> UC_Backlog
Doctor --> UC_Search
Doctor --> UC_Sign
Doctor --> UC_Kpi
Doctor --> UC_ByModality
Doctor --> UC_SevenDay
Doctor --> UC_Trend
Doctor --> UC_Report
Doctor --> UC_Export
Doctor --> UC_Guide

' An administrator can also do everything a doctor can do
Doctor <|-- Admin

Admin --> UC_Log
Admin --> UC_Edit
Admin --> UC_Import
Admin --> UC_AuditLog
Admin --> UC_TestData
Admin --> UC_Accounts
Admin --> UC_Sla
Admin --> UC_Window
Admin --> UC_Rooms

Public --> UC_Tv
HospitalIT --> UC_View
SyncAgent --> UC_Sync
UC_View --> RIS
UC_Sync --> RIS

' ==============================================================================
' INCLUDE / EXTEND (kept inside their own group where possible)
' ==============================================================================

UC_SignIn ..> UC_Default : <<include>>
UC_Sign ..> UC_Tat : <<include>>

UC_Kpi ..> UC_Filter : <<include>>
UC_ByModality ..> UC_Filter : <<include>>
UC_SevenDay ..> UC_Filter : <<include>>
UC_Trend ..> UC_Filter : <<include>>
' Extend arrows are written target-first (<..) so the main use case stays next to its actor
' and the optional ones sit to its right; the arrowheads still point at the main use case.
UC_SevenDay <.. UC_ComparePrev : <<extend>>

UC_Import <.. UC_Amend : <<extend>>
UC_Import <.. UC_AddRad : <<extend>>
UC_Import <.. UC_Rejected : <<extend>>
UC_AuditLog <.. UC_Undo : <<extend>>

legend bottom
  **An administrator can do everything a doctor can** (the hollow arrow), plus the Administration use cases.
  **Calculate TAT & SLA Breach:** TAT = Report signed − Exam completed (first sign-off). A breach is TAT **>** the SLA target
  for the exam's modality and patient category. It runs on every sign-off: on screen, by import and by RIS sync.
  **Audit trail:** every change to an examination (log, edit, cancel, delete, sign-off, import, amendment, undo)
  is recorded with who, when and the values before and after. Refused attempts are recorded too.
  **Signed-off exams are locked:** they change only through an import within the amendment window (default 7 days)
  that the administrator confirms. **Undo an Upload:** whole upload only, within the amendment window,
  and only if none of its exams changed afterwards.
  **RIS Integration (planned):** goes live only after the hospital approves RIS access.
endlegend

@enduml
