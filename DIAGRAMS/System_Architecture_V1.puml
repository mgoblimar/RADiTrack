@startuml raditrack_system_architecture
!theme plain
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial

title RADiTrack — System Architecture & Component Diagram (Zero-PII)

package "Data sources" as Sources {
    [Radiology Information System (RIS)\n<<pending hospital approval>>] as ExtRIS
    [RIS Sync Agent\n(read-only view raditrack.vw_exams,\nevery 5 min — branch feat/ris-sync-agent)] as SyncAgent
    [Spreadsheet file\n(.xlsx / .csv)] as SpreadsheetFile
}

package "Users' browsers" as Browsers {
    [Staff workstation\n(Radiologist, Resident, Administrator)] as StaffBrowser
    [Waiting-area TV\n(public, no sign-in)] as TvBrowser
}

package "RADiTrack web application (Next.js 16 on Vercel)" as AppLayer {

    [Sign-in check\n(proxy.ts, encrypted session cookie)] as Proxy

    package "Pages (React 19, Tailwind CSS 4)" as UI {
        [Staff dashboard  /\n(Dashboard, Examinations, Configuration,\nRIS Simulator, Guide)] as StaffDashboard
        [Patient TV  /patient] as PatientTv
        [PDF report  /report] as ReportPage
        [Sign in  /login\nChange password  /change-password] as AuthPages
    }

    package "Server actions (app/actions)" as Actions {
        [dashboard · analytics\n(KPIs, TAT by modality,\n7-day table, 12-month trend)] as Analytics
        [examinations\n(log, sign off, edit, cancel,\ndelete, search, CSV export)] as ExamActions
        [dataset\n(import preview & commit,\ntest data load & restore)] as DatasetActions
        [configurations · accounts · auth\n(SLA targets, rooms, users, sign-in)] as ConfigActions
        [patient\n(today's public counts)] as PatientActions
        [simulator\n(RIS Simulator scenarios)] as SimulatorActions
    }

    package "Shared logic (lib)" as Lib {
        [Spreadsheet reader & import rules\n(spreadsheet-rows, exam-import)] as ImportLib
        [Date windows in Manila time\n(kpi-range, app-time-zone)] as TimeLib
        [Prisma 7 client\n(lib/prisma.ts)] as PrismaClient
    }
}

package "Data layer (Supabase)" as DataLayer {
    database "PostgreSQL" as Database {
        [examinations] as TblExams
        [radiology_reports] as TblReports
        [modalities] as TblModalities
        [examination_statuses] as TblStatuses
        [sla_configurations] as TblSla
        [radiologists] as TblStaff
        [user_accounts] as TblUsers
        [examinations_backup ·\nradiology_reports_backup\n(only while test data is loaded)] as TblBackup
    }
}

' ==============================================================================
' CONNECTIONS & DATA FLOW
' ==============================================================================

ExtRIS ..> SyncAgent : read-only SELECT (planned)
SyncAgent ..> Database : add / update exams by accession (planned)
SpreadsheetFile --> StaffDashboard : Import exams (admin)

StaffBrowser --> Proxy : HTTPS
TvBrowser --> PatientTv : HTTPS (public page)
Proxy --> StaffDashboard
Proxy --> ReportPage
Proxy --> AuthPages

StaffDashboard --> Analytics : filters (time window, modality, category)
StaffDashboard --> ExamActions
StaffDashboard --> DatasetActions
StaffDashboard --> ConfigActions
StaffDashboard --> SimulatorActions
ReportPage --> Analytics
AuthPages --> ConfigActions
PatientTv --> PatientActions

DatasetActions --> ImportLib
Analytics --> TimeLib
PatientActions --> TimeLib

Analytics --> PrismaClient
ExamActions --> PrismaClient
DatasetActions --> PrismaClient
ConfigActions --> PrismaClient
PatientActions --> PrismaClient
SimulatorActions --> PrismaClient

PrismaClient --> Database : SQL queries & transactions

note bottom of Database
  No patient names, hospital numbers or images are stored.
  Each exam is identified only by its accession number.
end note

note right of StaffDashboard
  Open pages refresh every 10 s and
  at once when another tab changes data
  (BroadcastChannel "raditrack_sync").
end note

@enduml
